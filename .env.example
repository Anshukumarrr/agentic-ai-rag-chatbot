# Copy this file to ".env" and fill in your values.
#
# Any OpenAI-compatible endpoint works: official OpenAI, NVIDIA NIM,
# OpenRouter, Groq, a local Ollama server, etc.
# Leave OPENAI_BASE_URL empty to use the official OpenAI API.

OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=
CHAT_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small


# ---- Example: NVIDIA NIM (free tier, gives both a chat and an embedding model) ----
# OPENAI_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# CHAT_MODEL=openai/gpt-oss-20b
# EMBED_MODEL=nvidia/nemotron-3-embed-1b


# ---- RAG knobs ----
PDF_URL=https://konverge.ai/pdf/Ebook-Agentic-AI.pdf
PDF_PATH=data/Ebook-Agentic-AI.pdf
CHROMA_PATH=.chroma
TOP_K=4
# Chunks whose similarity is below this are treated as "not in the knowledge base".
MIN_SCORE=0.25
